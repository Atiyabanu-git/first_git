<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Apex University Homepage</title>
  <!-- Bootstrap 5.3 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>

  <!-- Header & Navbar -->
  <header class="sticky-top">
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
      <div class="container">
        <a class="navbar-brand fw-bold" href="#">Apex University</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
          <ul class="navbar-nav align-items-center">
            <li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Academics</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Admissions</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
            <!-- Dark/Light Mode Toggle Button -->
            <li class="nav-item ms-lg-3">
              <button class="btn btn-outline-secondary btn-sm" id="btnSwitch">🌙 Dark Mode</button>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <!-- Main Content Grid -->
  <main class="container my-5">
    <!-- Hero Row -->
    <div class="row align-items-center mb-5">
      <div class="col-lg-6 mb-4 mb-lg-0">
        <h1 class="display-4 fw-bold">Welcome to Apex University</h1>
        <p class="lead text-muted">Empowering minds, shaping future leaders, and fostering world-class research and innovation.</p>
        <a href="#courses" class="btn btn-primary btn-lg">Explore Programs</a>
      </div>
      <div class="col-lg-6">
        <div class="cover-container" style="width: 100%; height: 100%; overflow: hidden; border-radius: 12px;">
        <img src="https://static.npfs.co/accounts/5158/documents/2026/3/2/560445409f0e439b9b11cac3875f548e_ab-image.webp?1772456851" alt="Campus Image" style="width: 100%; height: 100%; object-fit: cover; display: block;">
      </div>    
        </div>
    </div>

    <!-- Content Cards Section -->
    <div class="row g-4" id="courses">
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h3 class="card-title h5">Undergraduate</h3>
            <p class="card-text text-muted">Discover our diverse bachelor degree programs tailored for real-world impact.</p>
            <a href="#" class="btn btn-outline-primary btn-sm">Learn More</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h3 class="card-title h5">Graduate & Research</h3>
            <p class="card-text text-muted">Advance your career with specialized master and doctoral research pathways.</p>
            <a href="#" class="btn btn-outline-primary btn-sm">Learn More</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h3 class="card-title h5">Campus Life</h3>
            <p class="card-text text-muted">Experience vibrant student organizations, athletics, housing, and wellness activities.</p>
            <a href="#" class="btn btn-outline-primary btn-sm">Learn More</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-body-tertiary border-top py-4 mt-5">
    <div class="container text-center text-muted">
      <p class="mb-0">&copy; 2026 Apex University. All rights reserved.</p>
    </div>
  </footer>

  <!-- Bootstrap JS Bundle CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  
  <!-- Toggle Script for Dark/Light Mode -->
  <script>
    const modeToggle = document.getElementById('btnSwitch');
    modeToggle.addEventListener('click', () => {
      const htmlEl = document.documentElement;
      const currentTheme = htmlEl.getAttribute('data-bs-theme');
      if (currentTheme === 'light') {
        htmlEl.setAttribute('data-bs-theme', 'dark');
        modeToggle.textContent = '☀️ Light Mode';
      } else {
        htmlEl.setAttribute('data-bs-theme', 'light');
        modeToggle.textContent = '🌙 Dark Mode';
      }
    });
  </script>
</body>
</html>